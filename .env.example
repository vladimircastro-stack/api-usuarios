# Copia este archivo como .env y completa los valores.

# Servidor
PORT=3000
NODE_ENV=production

# PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=api_usuarios
DB_PASSWORD=cambia_esta_contraseña
DB_PORT=5432

# JWT (usa un secreto largo y aleatorio en producción, mínimo 32 caracteres)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_minimo_32_chars

# Seguridad
CORS_ORIGIN=http://localhost:3000
ALLOW_PUBLIC_REGISTER=false
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
