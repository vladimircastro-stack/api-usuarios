# Copia este archivo como .env y completa los valores.

# Servidor
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=sgcrd
DB_PASSWORD=postgres
DB_PORT=5432

# JWT (usa un secreto largo y aleatorio en producción)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_minimo_32_chars

# Seguridad HTTP
CORS_ORIGIN=*
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
