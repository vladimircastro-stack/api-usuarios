{
  "info": {
    "name": "VC DistribuidorPro API - api-usuarios",
    "description": "Colección completa para probar usuarios, clientes, productos y ventas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "usuarioId", "value": "1" },
    { "key": "clienteId", "value": "1" },
    { "key": "productoId", "value": "1" },
    { "key": "ventaId", "value": "1" }
  ],
  "item": [
    {
      "name": "Sistema",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Raiz API",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Registrar Usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Demo\",\n  \"correo\": \"demo@example.com\",\n  \"edad\": 28,\n  \"password\": \"secreto123\"\n}"
            },
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  if (json.usuario && json.usuario.id) {",
                  "    pm.collectionVariables.set('usuarioId', json.usuario.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"demo@example.com\",\n  \"password\": \"secreto123\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Login Credenciales Invalidas",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"demo@example.com\",\n  \"password\": \"incorrecta\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Listar Usuarios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "Obtener Usuario por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Perfil",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/perfil"
          }
        },
        {
          "name": "Actualizar Usuario",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Demo Actualizado\",\n  \"correo\": \"demo@example.com\",\n  \"edad\": 29\n}"
            },
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Eliminar Usuario (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/clientes"
          }
        },
        {
          "name": "Crear Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.datos && json.datos.id) {",
                  "    pm.collectionVariables.set('clienteId', json.datos.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Demo\",\n  \"telefono\": \"8095550000\",\n  \"correo\": \"cliente@example.com\",\n  \"direccion\": \"Calle Principal 123\"\n}"
            },
            "url": "{{baseUrl}}/clientes"
          }
        },
        {
          "name": "Obtener Cliente por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/clientes/{{clienteId}}"
          }
        },
        {
          "name": "Actualizar Cliente (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Actualizado\",\n  \"telefono\": \"8095551111\",\n  \"correo\": \"cliente@example.com\",\n  \"direccion\": \"Nueva direccion 456\"\n}"
            },
            "url": "{{baseUrl}}/clientes/{{clienteId}}"
          }
        },
        {
          "name": "Eliminar Cliente (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/clientes/{{clienteId}}"
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar Productos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "Crear Producto (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.datos && json.datos.id) {",
                  "    pm.collectionVariables.set('productoId', json.datos.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Arroz Premium\",\n  \"categoria\": \"Granos\",\n  \"unidad_medida\": \"lb\",\n  \"cantidad\": 100,\n  \"precio_compra\": 20,\n  \"precio_venta\": 30\n}"
            },
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "Obtener Producto por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/productos/{{productoId}}"
          }
        },
        {
          "name": "Actualizar Producto (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Arroz Premium\",\n  \"categoria\": \"Granos\",\n  \"unidad_medida\": \"lb\",\n  \"cantidad\": 120,\n  \"precio_compra\": 21,\n  \"precio_venta\": 32\n}"
            },
            "url": "{{baseUrl}}/productos/{{productoId}}"
          }
        },
        {
          "name": "Eliminar Producto (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/productos/{{productoId}}"
          }
        }
      ]
    },
    {
      "name": "Ventas",
      "item": [
        {
          "name": "Listar Ventas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/ventas"
          }
        },
        {
          "name": "Crear Venta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.datos && json.datos.id) {",
                  "    pm.collectionVariables.set('ventaId', json.datos.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": {{clienteId}},\n  \"productos\": [\n    {\n      \"producto_id\": {{productoId}},\n      \"cantidad\": 2\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/ventas"
          }
        },
        {
          "name": "Obtener Venta por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/ventas/{{ventaId}}"
          }
        }
      ]
    }
  ]
}
